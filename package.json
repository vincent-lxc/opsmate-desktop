{
  "name": "opsmate-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpsMate secure desktop client — independent React + Tauri shell",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/admin run dev",
    "build:web": "npm --prefix apps/admin ci && npm --prefix apps/admin test && npm --prefix apps/admin run build && npm --prefix apps/desktop ci",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:generate": "node scripts/generate-operations.mjs",
    "contracts:check": "node scripts/generate-operations.mjs --check",
    "tauri": "npm --prefix apps/desktop run tauri --",
    "dev:tauri": "npm run build:web && npm --prefix apps/desktop run tauri -- dev",
    "build": "npm run build:web && npm --prefix apps/desktop run tauri -- build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.9"
  },
  "license": "MPL-2.0"
}
